# Backend environment variables (production example - DO NOT commit real secrets)
DATABASE_URL=postgresql://user:password@db-host:5432/pulsecrm_ai
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
